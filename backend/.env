PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/condominio_florida?schema=public"
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/condominio_florida_test?schema=public"

ADMIN_SETUP_KEY="condominio-florida-setup-key-2024"

JWT_ACCESS_TOKEN_SECRET="dev-secret-key-change-in-production-USE-OPENSSL-RAND"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_SECRET="dev-refresh-secret-key-change-in-production-USE-OPENSSL-RAND"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"
JWT_ISSUER="condominio-florida"

BCRYPT_ROUNDS=12

LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

FRONTEND_URL="http://localhost:5173"

TZ="America/Sao_Paulo"
