{
  "name": "condominio-florida-backend",
  "version": "1.0.0",
  "description": "Backend do Sistema de Reservas do Condomínio Flórida",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:test": "vitest",
    "build": "npx prisma generate && tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "init-db": "psql -d postgresql://postgres:postgres@localhost:5432/condominio_florida -f schema.sql && npx prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "cron": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^8.17.0",
    "qrcode": "^1.5.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.30",
    "@types/qrcode": "^1.5.4",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.2.1",
    "@typescript-eslint/parser": "^7.2.1",
    "cookie-parser": "^1.4.6",
    "eslint": "^8.57.0",
    "prisma": "^5.22.0",
    "supertest": "^6.3.3",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  }
}
