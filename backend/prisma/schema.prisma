generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(uuid()) @db.Uuid
  fullName            String
  email               String             @unique
  cpf                 String?            @unique
  passwordHash        String
  role                UserRole           @default(RESIDENT)
  status              UserStatus         @default(PENDING)
  block               String?
  apartment           String?
  phone               String?
  unit                String?
  isFirstLogin        Boolean            @default(true)
  createdAt           DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(6)
  lastLoginAt         DateTime?
  refreshToken        String?
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  bookings            Booking[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  maintenanceBlocks   MaintenanceBlock[] @relation("MaintenanceCreatedBy")

  @@index([cpf, email])
}

enum UserRole {
  ADMIN
  RESIDENT
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
  LOCKED
}

model Area {
  id                        String     @id @default(uuid()) @db.Uuid
  name                      String
  description               String?
  capacity                  Int        @default(1)
  location                  String?
  active                    Boolean    @default(true)
  openingTime               String
  closingTime               String
  operatingDays             Int[]
  reservationDurationMinutes Int       @default(60)
  minBookingNoticeHours     Int        @default(1)
  advanceBookingDays        Int        @default(7)
  requiresApproval          Boolean    @default(false)
  image                     String?
  createdAt                 DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime   @updatedAt @db.Timestamptz(6)
  bookings                  Booking[]
  maintenanceBlocks         MaintenanceBlock[]
  qrCodes                   BookingQrCode[]

  @@index([active])
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  residentId      String        @db.Uuid
  resident        User          @relation(fields: [residentId], references: [id])
  areaId          String        @db.Uuid
  area            Area          @relation(fields: [areaId], references: [id])
  startsAt        DateTime      @db.Timestamptz(6)
  endsAt          DateTime      @db.Timestamptz(6)
  guestCount      Int           @default(1)
  purpose         String?
  status          BookingStatus @default(PENDING)
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    String?
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?
  completedAt     DateTime?
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  qrCode          BookingQrCode?
  checkins        BookingCheckin[]
  notifications   Notification[]

  @@index([residentId, status])
  @@index([areaId, startsAt, endsAt])
  @@index([status, startsAt])
  @@index([startsAt, endsAt])
  @@index([status])
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

model MaintenanceBlock {
  id                  String    @id @default(uuid()) @db.Uuid
  areaId              String    @db.Uuid
  area                Area      @relation(fields: [areaId], references: [id])
  startsAt            DateTime  @db.Timestamptz(6)
  endsAt              DateTime  @db.Timestamptz(6)
  reason              String
  createdBy           String    @db.Uuid
  creator             User      @relation("MaintenanceCreatedBy", fields: [createdBy], references: [id])
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  conflictingBookings String[]  @default([])
  notifications       Notification[]

  @@index([areaId, startsAt, endsAt])
  @@index([createdBy])
}

model BookingQrCode {
  id          String    @id @default(uuid()) @db.Uuid
  bookingId   String    @unique @db.Uuid
  booking     Booking   @relation(fields: [bookingId], references: [id])
  areaId      String?   @db.Uuid
  area        Area?     @relation(fields: [areaId], references: [id])
  token       String    @unique @default(uuid())
  expiresAt   DateTime  @db.Timestamptz(6)
  usedAt      DateTime?
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  checkins    BookingCheckin[]

  @@index([token])
  @@index([bookingId])
}

model BookingCheckin {
  id          String    @id @default(uuid()) @db.Uuid
  bookingId   String    @db.Uuid
  booking     Booking   @relation(fields: [bookingId], references: [id])
  qrCodeId    String?   @db.Uuid
  qrCode      BookingQrCode? @relation(fields: [qrCodeId], references: [id])
  validatedBy String
  checkinAt   DateTime  @default(now()) @db.Timestamptz(6)
  ipAddress   String?

  @@index([bookingId])
}

model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @db.Uuid
  user      User?     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action])
}

model Notification {
  id            String      @id @default(uuid()) @db.Uuid
  recipientId   String      @db.Uuid
  recipient     User        @relation(fields: [recipientId], references: [id])
  eventType     String
  title         String
  message       String
  read          Boolean     @default(false)
  metadata      Json?
  bookingId     String?     @db.Uuid
  booking       Booking?    @relation(fields: [bookingId], references: [id])
  maintenanceId String?
  maintenance   MaintenanceBlock? @relation(fields: [maintenanceId], references: [id])
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  deliveredAt   DateTime?

  @@index([recipientId, read])
  @@index([eventType])
  @@index([bookingId])
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique(map: "system_setting_key")
  value       String
  type        String   @default("string")
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@unique([key], map: "system_setting_key_unique")
}

model FailedLogin {
  id        String   @id @default(uuid()) @db.Uuid
  cpf       String
  ipAddress String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  reason    String?

  @@index([cpf, createdAt])
  @@index([createdAt])
}

model LoginAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  identifier  String
  ipAddress   String?
  success     Boolean
  attemptedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifier, attemptedAt])
  @@index([identifier, success])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  revoked   Boolean  @default(false)

  @@index([userId])
  @@index([token])
}
